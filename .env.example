# Copy to .env and adjust as needed. Used by docker-compose.yml.

# MinIO (local S3-compatible — stand-in for the warm tier)
MINIO_ROOT_USER=otelgw
MINIO_ROOT_PASSWORD=otelgw-warm-tier
MINIO_BUCKET=warm-tier

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Simulated cost (USD per GB) — used in the showback recording rules.
COST_PER_GB_HOT=0.50
COST_PER_GB_WARM=0.023
