# Copie para .env e ajuste se necessário. Usado pelo docker-compose.yml.

# MinIO (S3-compatible local — stand-in para o warm tier)
MINIO_ROOT_USER=otelgw
MINIO_ROOT_PASSWORD=otelgw-warm-tier
MINIO_BUCKET=warm-tier

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Custo simulado (USD por GB) — usado nas recording rules de showback.
COST_PER_GB_HOT=0.50
COST_PER_GB_WARM=0.023
