{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "service-catalog",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "tier", "team", "cost_center", "compliance_hold"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "tier": {"type": "string", "enum": ["critical", "standard", "low"]},
          "team": {"type": "string", "minLength": 1},
          "cost_center": {"type": "string", "minLength": 1},
          "compliance_hold": {"type": "boolean"}
        }
      }
    }
  }
}
